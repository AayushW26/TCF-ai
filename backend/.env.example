# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# ── Redis (Upstash) ──────────────────────────────────────
REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# ── Google Gemini ─────────────────────────────────────────
GEMINI_API_KEY=AIza...your-gemini-key

# ── Meta WhatsApp Cloud API ───────────────────────────────
META_ACCESS_TOKEN=EAAx...your-access-token
META_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
META_APP_SECRET=abc123...your-app-secret

# ── Cloudmailin (Email Ingestion) ─────────────────────────
CLOUDMAILIN_SECRET=your-cloudmailin-secret
CLOUDMAILIN_EMAIL_DOMAIN=munim.cloudmailin.net

# ── DeepVue.tech (GSTIN Validation) ──────────────────────
DEEPVUE_API_KEY=your-deepvue-api-key
DEEPVUE_CLIENT_ID=your-deepvue-client-id

# ── JWT Auth ──────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ── Application ──────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
